<% layout("/layouts/boilerplate.ejs") %>

    <div class="about-page">

        <!-- =========================
         HERO SECTION
    ========================== -->
        <section class="about-hero">

            <div class="about-hero-content">

                <span class="about-tag">
                    ABOUT SOMNATH ALBUMS
                </span>

                <h1>
                    Turning Your
                    <span>Memories</span>
                    Into Art
                </h1>

                <p>
                    We design and edit beautiful, timeless albums that preserve
                    your most precious moments in a creative and elegant way.
                </p>

                <a href="/somnath/contact" class="about-btn">
                    Let's Create Together
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>


            <div class="about-hero-decoration">

                <div class="about-circle circle-one"></div>

                <div class="about-circle circle-two"></div>

                <div class="about-frame">

                    <i class="bi bi-images"></i>

                    <span>Memories</span>

                </div>

            </div>

        </section>


        <!-- =========================
         INTRO / WHO WE ARE
    ========================== -->
        <section class="about-intro">

            <!-- YOUR IMAGE -->
            <div class="about-intro-image">

                <div class="image-box">

                    <img src="/about.png" alt="Somnath Albums">

                </div>

            </div>


            <!-- CONTENT -->
            <div class="about-intro-content">

                <span class="section-label">
                    WHO WE ARE
                </span>

                <h2>
                    Every Picture Has
                    <span>A Story</span>
                </h2>

                <p>
                    Somnath Albums is an album designing and editing studio
                    dedicated to transforming photographs into beautifully
                    designed memories.
                </p>

                <p>
                    I don’t design pages I compose memories into a visual rhythm.
                    Every frame is carefully placed to let emotions breathe beyond the photograph.
                    My passion lives in the smallest details the balance, the mood, and the story.
                    With every album, I create something meant to be felt today and cherished forever
                </p>


                <!-- FEATURES -->
                <div class="about-features">

                    <!-- FEATURE 1 -->
                    <div class="about-feature">

                        <div class="feature-icon">
                            <i class="bi bi-palette"></i>
                        </div>

                        <div>

                            <h3>
                                Creative Design
                            </h3>

                            <p>
                                Unique layouts created for your memories.
                            </p>

                        </div>

                    </div>


                    <!-- FEATURE 2 -->
                    <div class="about-feature">

                        <div class="feature-icon">
                            <i class="bi bi-stars"></i>
                        </div>

                        <div>

                            <h3>
                                Premium Layouts
                            </h3>

                            <p>
                                Careful editing to make every image shine.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
         SERVICES
    ========================== -->
        <section class="about-services">

            <div class="about-section-heading">

                <span class="section-label">
                    WHAT WE DO
                </span>

                <h2>
                    Our <span>Services</span>
                </h2>

                <p>
                    From selecting the right photographs to creating the final
                    album layout, we focus on every detail.
                </p>

            </div>


            <div class="services-grid">

                <!-- SERVICE 1 -->
                <div class="service-card">

                    <div class="service-number">
                        01
                    </div>

                    <div class="service-icon">
                        <i class="bi bi-book"></i>
                    </div>

                    <h3>
                        Album Designing
                    </h3>

                    <p>
                        Elegant and creative album layouts designed around
                        your photographs and memories.
                    </p>

                </div>


                <!-- SERVICE 2 -->
                <div class="service-card">

                    <div class="service-number">
                        02
                    </div>

                    <div class="service-icon">
                        <i class="bi bi-magic"></i>
                    </div>

                    <h3>
                        Photo Editing
                    </h3>

                    <p>
                        Professional image editing and enhancement to give
                        your photographs a polished appearance.
                    </p>

                </div>


                <!-- SERVICE 3 -->
                <div class="service-card">

                    <div class="service-number">
                        03
                    </div>

                    <div class="service-icon">
                        <i class="bi bi-heart"></i>
                    </div>

                    <h3>
                        Wedding Albums
                    </h3>

                    <p>
                        Beautiful wedding album designs that tell the story
                        of your special day.
                    </p>

                </div>


                <!-- SERVICE 4 -->
                <div class="service-card">

                    <div class="service-number">
                        04
                    </div>

                    <div class="service-icon">
                        <i class="bi bi-images"></i>
                    </div>

                    <h3>
                        Pre-Wedding Albums
                    </h3>

                    <p>
                        Stylish layouts that bring your pre-wedding memories
                        together in one beautiful album.
                    </p>

                </div>

            </div>

        </section>


        <!-- =========================
         PROCESS
    ========================== -->
        <section class="about-process">

            <div class="about-section-heading">

                <span class="section-label">
                    OUR PROCESS
                </span>

                <h2>
                    From Photos To
                    <span>Memories</span>
                </h2>

            </div>


            <div class="process-grid">

                <!-- STEP 1 -->
                <div class="process-item">

                    <div class="process-icon">
                        <i class="bi bi-cloud-arrow-up"></i>
                    </div>

                    <span>
                        01
                    </span>

                    <h3>
                        Share Your Photos
                    </h3>

                    <p>
                        Send us your photographs and tell us about your
                        requirements.
                    </p>

                </div>


                <div class="process-line"></div>


                <!-- STEP 2 -->
                <div class="process-item">

                    <div class="process-icon">
                        <i class="bi bi-pencil-square"></i>
                    </div>

                    <span>
                        02
                    </span>

                    <h3>
                        Design &amp; Edit
                    </h3>

                    <p>
                        We carefully design your album and edit the
                        photographs.
                    </p>

                </div>


                <div class="process-line"></div>


                <!-- STEP 3 -->
                <div class="process-item">

                    <div class="process-icon">
                        <i class="bi bi-check2-circle"></i>
                    </div>

                    <span>
                        03
                    </span>

                    <h3>
                        Final Album
                    </h3>

                    <p>
                        Your memories are ready to become a beautiful
                        finished album.
                    </p>

                </div>

            </div>

        </section>


        <!-- =========================
         WHY US
    ========================== -->
        <section class="about-why">

            <div class="why-content">

                <span class="section-label">
