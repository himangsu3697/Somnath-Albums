<% layout("/layouts/boilerplate.ejs") %>

    <div class="single-asset-page">

        <!-- PAGE HEADER -->
        <div class="single-asset-header">
            <span class="single-asset-label">ALBUM DESIGN</span>

            <h1>
                <%= asset.name %>
            </h1>

            <p>
                View asset details and preview
            </p>
        </div>


        <!-- ASSET -->
        <div class="single-asset-container">

            <div class="single-asset-image">

                <img src="<%= asset.url %>" alt="<%= asset.name %> album design">

            </div>


            <!-- DETAILS -->
            <div class="single-asset-details">

                <span class="single-detail-label">
                    ASSET NAME
                </span>

                <h2>
                    <%= asset.name %>
                </h2>


                <div class="single-detail-row">

                    <span>Asset ID</span>

                    <strong>
                        <%= asset._id %>
                    </strong>

                </div>


                <div class="single-detail-row">

                    <span>Category</span>

                    <strong>
                        <%= asset.name %>
                    </strong>

                </div>


                <div class="single-detail-row">

                    <span>Asset URL</span>

                    <a href="<%= asset.url %>" target="_blank" rel="noopener noreferrer">
                        Open Image
                        <i class="bi bi-box-arrow-up-right"></i>
                    </a>

                </div>


                <!-- ACTIONS -->
                <div class="single-asset-actions">

                    <a href="<%= asset.url %>" target="_blank" rel="noopener noreferrer"
                        class="single-btn single-btn-primary">
                        <i class="bi bi-image"></i>
                        Open Image
                    </a>


                   <%if(isAdmin) {%>
                     <form action="/somnath/store/<%= asset._id %>?_method=DELETE" method="post"
                        onsubmit="return confirm('Are you sure you want to delete this asset?');">

                        <button type="submit" class="single-btn single-btn-delete">
                            <i class="bi bi-trash3"></i>
                            Delete Asset
                        </button>

                    </form>
                    <%}%>
                </div>

            </div>

        </div>

    </div>